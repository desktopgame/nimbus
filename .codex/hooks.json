{
  "description": "Secret leak canary for Codex using BetterLeaks.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/sensitive-canary.ps1')\"",
            "commandWindows": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/sensitive-canary.ps1')\"",
            "timeout": 10,
            "statusMessage": "Scanning prompt for secrets..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/sensitive-canary.ps1')\"",
            "commandWindows": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/sensitive-canary.ps1')\"",
            "timeout": 10,
            "statusMessage": "Checking command for sensitive data..."
          }
        ]
      }
    ]
  }
}
