glfw-*/docs
glfw-*/examples
glfw-*/tests

freetype-*/docs/*
# Keep the canonical license texts (FTL.TXT, GPLv2.TXT) so distributors of
# nimbus apps can find them in-tree. See doc/distribution.md.
!freetype-*/docs/FTL.TXT
!freetype-*/docs/GPLv2.TXT
freetype-*/builds
freetype-*/tests
freetype-*/devel
freetype-*/objs
freetype-*/subprojects

# zigimg's own build.zig auto-runs its test suite via Zig's package
# discovery (build.zig.zon adjacency triggers it). We use createModule
# directly, so remove these to keep `zig build test` clean.
zigimg-*/build.zig
zigimg-*/build.zig.zon

**/.gitattributes