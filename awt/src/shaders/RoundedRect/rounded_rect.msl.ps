// Fragment shader for the RoundedRect program (MSL / Metal).
// Mirrors the HLSL version: rounded-rect SDF with optional outline,
// 1-pixel smoothstep AA band.

#include <metal_stdlib>
using namespace metal;

struct VsOut {
    float4 pos [[position]];
    float2 uv;
};

struct Uniforms {
    float4 color;
    float2 half_size;     // bounding box half-extent in PIXELS
    float corner_radius;  // PIXELS; 0 = sharp corners
    float thickness;      // PIXELS; 0 = filled, >0 = outline of that width
};

static float sd_rounded_rect(float2 p, float2 size, float r) {
    float2 q = abs(p) - size + r;
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
}

fragment float4 psMain(VsOut in [[stage_in]],
                       constant Uniforms& u [[buffer(0)]]) {
    float2 p = in.uv * u.half_size;
    float d = sd_rounded_rect(p, u.half_size, u.corner_radius);
    if (u.thickness > 0.0) d = abs(d) - u.thickness * 0.5;
    float alpha = 1.0 - smoothstep(-0.5, 0.5, d);
    return float4(u.color.rgb, u.color.a * alpha);
}
