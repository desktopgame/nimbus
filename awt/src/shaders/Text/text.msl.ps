// Fragment shader for the Text program (MSL / Metal).
// Samples R channel of the glyph atlas and uses it as alpha against the
// uniform color.

#include <metal_stdlib>
using namespace metal;

struct VsOut {
    float4 pos [[position]];
    float2 uv;
};

struct Uniforms {
    float4 color;
};

fragment float4 psMain(VsOut in [[stage_in]],
                       constant Uniforms& u [[buffer(0)]],
                       texture2d<float> tex [[texture(0)]],
                       sampler samp [[sampler(0)]]) {
    float a = tex.sample(samp, in.uv).r;
    return float4(u.color.rgb, a * u.color.a);
}
