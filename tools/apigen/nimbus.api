# nimbus C ABI binding spec — input to tools/apigen.
# Regenerate the output (include/nimbus.h + framework/src/c_api.zig) with:
#     zig build apigen
#
# Grammar (one statement per line; '#' .. end-of-line is a comment):
#
#   struct <CName> { <field>:<scalar> ... }
#       A by-value record whose layout is exposed across the ABI (generated as a
#       C struct + an `extern struct`). <scalar> in { f32, f64, i32, u32, usize, bool }
#       (usize -> C size_t).
#       Used as an arg (<name>:<CName>) or return (-> <CName>); shims convert
#       field-by-field to/from the native (plain) Zig struct of the same shape.
#
#   enum <CName> = <NativeZigPath> { <member> ... }
#       An enum exposed across the ABI as an int (C enum). Members in native
#       declaration order (values 0,1,2,...). A comptime check against the
#       native enum (e.g. Component.Alignment) makes a reorder/rename a build
#       error. Used as an arg (<name>:<CName>) or return (-> <CName>).
#
#   callback <CName> = <NativeEventType>
#       An event-handler callback. C side: a `{ fn, userdata }` box (typedef
#       <CName>), passed by pointer; the event is delivered as an opaque
#       `const void*` (read via nmEvent* accessors in the preamble). A generated
#       Zig trampoline plugs into the typed addXxxListener. Use as an arg
#       (<name>:<CName>). <NativeEventType> is framework-relative (the event the
#       native listener delivers, e.g. ChangeListenerList.Event).
#
#   opaque <ZigType> [: <Parent>]
#       Declares an opaque handle. Emitted as
#           typedef struct nm<ZigType> nm<ZigType>;
#       and always crosses the ABI by pointer. The optional ": <Parent>"
#       records single inheritance for the binding IR (so a target-language
#       class can inherit the parent's methods / support asXxx casts).
#
#   fn <CName> = <ZigType>.<method> ( [<recv> ,] <arg>* ) -> <ret> [!<fail>] [<own>]
#       <recv> : &self   receiver is *T   (Zig: self: *T)
#                =self   receiver is T     (by value; still a pointer in C)
#       <arg>  : <name>:<type> [<own>]    type in { str, ?str, *<ZigType>, ?*<ZigType> }
#                ?str        = optional UTF-8 string arg (nullable const char*; null = none).
#                ?*<ZigType> = optional handle arg (nullable pointer; null = none).
#       <ret>  : void | *<ZigType> | ?*<ZigType> | <scalar> | <struct> | <enum>
#                | str    borrowed []const u8 -> nmStr {ptr,len} (UTF-8, not NUL-term)
#                | ?str   optional ?[]const u8 -> nmStr (ptr = null when none)
#                | ?*<ZigType>  optional handle return (nullable pointer; null = none;
#                               cannot combine with !fail since NULL already = none)
#       <fail> : !null   failure = NULL  + last_error          (for *T returns)
#                !err    failure = nonzero int (0 = ok)         (for void returns)
#       <own>  : @owned     caller owns the returned handle (must free it)
#                @borrowed  returned handle is borrowed (must NOT free it)
#                @transfer  this argument's ownership moves to the callee
#                Drives the binding's free/no-free decision. Emitted into the IR.
#                Unspecified: handle returns default to owned, handle args to
#                borrowed (binding-side convention).
#
#   cast <CName> = <ZigType>.<field> -> <TargetType>
#       Upcast helper: emits `return &self.<field>` as a *<TargetType> handle.
#
#   destroy <CName> = <ZigType>
#       Generic destructor: emits `self.vtable.destroy(self, self.allocator)`.
#       Meaningful on Component (the type that carries vtable + allocator).
#
# The generated shim calls the real Zig method, so any drift between this spec
# and the actual signature is caught at compile time — never silently.
#
# Not yet supported (see doc/c_api_codegen.md「未対応」): struct / enum / int
# args, slice ([]const u8) returns, callbacks, and bootstrap constructors that
# need an allocator / io (those are hand-written in tools/apigen/preamble.zig).

opaque Component
opaque Container : Component
opaque Button    : Component
opaque ComboBox  : Component
opaque Frame
opaque Application

# Pure-A widgets: properties / factories / listeners that generate with no
# hand-writing. Inheritance (`: <Parent>`) records the upcast chain for the IR.
opaque Label       : Component
opaque Panel       : Container
opaque CheckBox    : Component
opaque RadioButton : Component
opaque Slider      : Component
opaque ScrollBar   : Component
opaque TextField   : Component
opaque TextArea    : Component
# Top-level window (borrowed via nmFrameAsWindow; the Frame owns it). Not a Component.
opaque Window
# Owner-bound dialog (modal or modeless). Caller-owned (the Application registers
# it with a no-op destroy), so it is freed by the hand-written nmDialogDestroy.
opaque Dialog
# Menu family. All are Components except PopupMenu, a free overlay with its own destructor.
opaque MenuItem         : Component
opaque CheckBoxMenuItem : Component
opaque Menu             : Component
opaque MenuBar          : Component
opaque MenuSeparator    : Component
opaque PopupMenu
# Widget state models (owned by their widget; reached via getModel as a borrow).
opaque ButtonModel
opaque ToggleButtonModel
opaque BoundedRangeModel
# Layout manager (built-in instances are process-wide singletons; always borrowed).
opaque LayoutManager

# awt.Image (a GPU-texture-backed value type) boxed as a handle. Its methods
# (load / destroy / width / height / getIcon / setIcon / app icon) are bespoke
# and hand-written in preamble.zig (see doc/c_api_codegen.md「Image / icon」);
# only the handle typedef + IR type entry are generated from this line.
opaque Image
# List (vertical single-selection, JavaFX VirtualFlow cells) + its ListModel.
# The cell factory / model / index API is bespoke (void* items, usize indices,
# an interface-returning-interface factory) and hand-written in preamble.zig
# (see doc/c_api_codegen.md「List / CellFactory」). Only the handle typedefs,
# the rowHeight / change-listener methods, and the Component upcast are generated.
opaque List : Component
opaque ListModel

# Value struct: its layout is exposed across the ABI (generated as an
# `extern struct`; shims convert field-by-field to/from the native Color).
# Field names must match the native awt.Graphics.Color (else a compile error).
struct nmColor { r:f32 g:f32 b:f32 a:f32 }
struct nmSize  { width:f32 height:f32 }
# Window geometry is integer device pixels (awt.Window.Point / awt.Window.Size).
struct nmWindowPoint { x:i32 y:i32 }
struct nmWindowSize  { width:i32 height:i32 }
# Float coordinate point (Component.Point) — e.g. Menu.show anchor.
struct nmPoint { x:f32 y:f32 }
# Component.Rect (awt.Graphics.Rect) — float bounds.
struct nmRect { x:f32 y:f32 width:f32 height:f32 }

# Enum: crosses the ABI as an int. Member order must match the native enum;
# a comptime check (against Component.Alignment) makes a mismatch a build error.
enum nmAlignment = Component.Alignment { start center end stretch }
# Slider and ScrollBar share the same member order but are distinct native enums;
# each gets its own drift-checked mirror.
enum nmOrientation       = Slider.Orientation    { horizontal vertical }
enum nmScrollOrientation = ScrollBar.Orientation { horizontal vertical }
# BorderLayout region for child placement (BorderLayout.add).
enum nmBorderRegion = BorderLayout.Region { north south east west center }
# Modal dialog outcome. Native Dialog.Result is non-exhaustive (enum(i32) + `_`),
# so arbitrary i32 codes still pass through @enumFromInt/@intFromEnum; only these
# three carry names + a drift check.
enum nmDialogResult = Dialog.Result { none ok cancel }

# Event-handler callback. native event = ChangeListenerList.Event; the C side
# passes a { fn, userdata } box pointer and receives the event as an opaque
# const void* (read via nmEventKind / nmEventSource).
callback nmChangeListener = ChangeListenerList.Event

# Run the event loop until all windows close. (nmAppCreate / nmAppDestroy are
# hand-written in preamble.zig — they need an allocator / io.)
fn nmAppRun        = Application.run    (&self) -> void !err
fn nmAppButton     = Application.button (&self, text:str) -> *Button !null @owned
fn nmButtonSetText = Button.setText     (&self, text:str) -> void    !err
fn nmContainerAdd  = Container.add       (&self, child:*Component @transfer) -> void !err
# remove detaches the child (does not destroy it) — borrowed arg.
fn nmContainerRemove = Container.remove   (&self, child:*Component) -> void
fn nmButtonSetColor = Button.setColor    (&self, c:nmColor) -> void
fn nmButtonGetColor = Button.getColor    (=self) -> nmColor
fn nmButtonGetModel = Button.getModel    (=self) -> *ButtonModel @borrowed

# Borrowed string return (nmStr = ptr + len, UTF-8, not NUL-terminated).
fn nmButtonGetText       = Button.getText          (=self) -> str
fn nmComboBoxGetSelected = ComboBox.getSelectedItem (=self) -> ?str

# Optional value struct (?Size). Arg = nullable const ptr; return = out-param + bool.
fn nmButtonSetIconSize = Button.setIconSize (&self, sz:?nmSize) -> void
fn nmButtonGetIconSize = Button.getIconSize (=self) -> ?nmSize

# Primitive (scalar) args / return: passed straight through, no conversion.
# The Frame is owned by Application (freed on close / app deinit), so @borrowed.
fn nmAppFrame          = Application.frame   (&self, title:str, w:u32, h:u32) -> *Frame !null @borrowed
fn nmComponentSetGrowX = Component.setGrowX  (&self, v:f32) -> void
fn nmComponentGetGrowX = Component.getGrowX  (&self) -> f32
fn nmComponentSetAlignX = Component.setAlignX (&self, a:nmAlignment) -> void
fn nmComponentGetAlignX = Component.getAlignX (&self) -> nmAlignment

# Component common methods (#1). Apply to every widget via the AsComponent casts.
# min/max size は CLAUDE.md 方針で意図的に非公開。
fn nmComponentSetGrowY  = Component.setGrowY  (&self, v:f32) -> void
fn nmComponentGetGrowY  = Component.getGrowY  (&self) -> f32
fn nmComponentSetAlignY = Component.setAlignY (&self, a:nmAlignment) -> void
fn nmComponentGetAlignY = Component.getAlignY (&self) -> nmAlignment
fn nmComponentIsFocusable  = Component.isFocusable  (&self) -> bool
fn nmComponentSetFocusable = Component.setFocusable (&self, v:bool) -> void
fn nmComponentRequestFocus = Component.requestFocus (&self) -> void
fn nmComponentRepaint      = Component.repaint      (&self) -> void
fn nmComponentMarkLayoutDirty = Component.markLayoutDirty (&self) -> void
fn nmComponentGetName = Component.getName (=self) -> ?str
fn nmComponentSetName = Component.setName (&self, name:?str) -> void
fn nmComponentContainsWindowPoint = Component.containsWindowPoint (&self, x:f32, y:f32) -> bool
fn nmComponentGetBounds = Component.getBounds (=self) -> nmRect
fn nmComponentSetBounds = Component.setBounds (&self, r:nmRect) -> void
fn nmComponentAbsoluteOrigin = Component.absoluteOriginInWindow (&self) -> nmPoint

# Factory taking a string array (strs -> const char* const* + count).
fn nmAppComboBox       = Application.comboBox (&self, items:strs) -> *ComboBox !null @owned

# Event handler: the cb box is registered via the typed addChangeListener.
# remove uses the same box pointer to match-and-unregister (off = remove).
fn nmComboBoxOnChange  = ComboBox.addChangeListener    (&self, cb:nmChangeListener) -> void !err
fn nmComboBoxOffChange = ComboBox.removeChangeListener (&self, cb:nmChangeListener) -> void

# ComboBox index API (the first usize consumer: size_t args / returns).
fn nmComboBoxGetSelectedIndex = ComboBox.getSelectedIndex (=self) -> usize
fn nmComboBoxSetSelectedIndex = ComboBox.setSelectedIndex (&self, idx:usize) -> void
fn nmComboBoxItemCount        = ComboBox.getItemCount      (=self) -> usize
fn nmComboBoxGetItem          = ComboBox.getItem           (=self, idx:usize) -> ?str
fn nmComboBoxIsEnabled        = ComboBox.isEnabled         (=self) -> bool
fn nmComboBoxSetEnabled       = ComboBox.setEnabled        (&self, v:bool) -> void

# List: the parts that fit the generator (scalar row height, change listener).
# The factory / model / selection / edit API is hand-written (preamble.zig).
fn nmListGetRowHeight = List.getRowHeight (=self) -> f32
fn nmListSetRowHeight = List.setRowHeight (&self, h:f32) -> void
fn nmListEdit         = List.edit         (&self, idx:usize) -> void
fn nmListOnChange     = List.addChangeListener    (&self, cb:nmChangeListener) -> void !err
fn nmListOffChange    = List.removeChangeListener (&self, cb:nmChangeListener) -> void

# ── Pure-A widgets (bulk) ─────────────────────────────────────────────────────
# Property get/set, the remaining factories, and listeners that fit the generator
# with no hand-writing. Receiver: &self for *Self / *const Self methods, =self for
# by-value. getModel returns are @borrowed (the widget owns its model). add()
# transfers child ownership to the container (as nmContainerAdd). All listeners
# deliver ChangeListenerList.Event, so they reuse nmChangeListener.

# Application factories (the rest; each allocates a widget -> owned *T).
fn nmAppLabel            = Application.label            (&self, text:str) -> *Label       !null @owned
fn nmAppContainer        = Application.container        (&self) -> *Container   !null @owned
fn nmAppPanel            = Application.panel            (&self) -> *Panel       !null @owned
fn nmAppCheckBox         = Application.checkBox         (&self, text:str) -> *CheckBox    !null @owned
fn nmAppRadioButton      = Application.radioButton      (&self, text:str) -> *RadioButton !null @owned
fn nmAppSlider           = Application.slider           (&self, orientation:nmOrientation, min:i32, value:i32, max:i32) -> *Slider !null @owned
fn nmAppScrollBar        = Application.scrollBar        (&self, orientation:nmScrollOrientation, min:i32, value:i32, max:i32) -> *ScrollBar !null @owned
fn nmAppTextField        = Application.textField        (&self, text:str) -> *TextField !null @owned
fn nmAppTextArea         = Application.textArea         (&self, text:str) -> *TextArea  !null @owned
fn nmAppFiller           = Application.filler           (&self) -> *Panel !null @owned
fn nmAppToolBar          = Application.toolBar          (&self) -> *Panel !null @owned
fn nmAppMenu             = Application.menu             (&self, text:str) -> *Menu !null @owned
fn nmAppMenuItem         = Application.menuItem         (&self, text:str) -> *MenuItem !null @owned
fn nmAppCheckBoxMenuItem = Application.checkBoxMenuItem (&self, text:str) -> *CheckBoxMenuItem !null @owned
fn nmAppMenuBar          = Application.menuBar          (&self) -> *MenuBar !null @owned
fn nmAppPopupMenu        = Application.popupMenu        (&self) -> *PopupMenu !null @owned
fn nmAppMenuSeparator    = Application.menuSeparator    (&self) -> *MenuSeparator !null @owned

# Label (setFont/getFont take awt.Graphics.TextFont, which wraps a Font handle -> bespoke)
fn nmLabelSetText  = Label.setText  (&self, text:str) -> void !err
fn nmLabelGetText  = Label.getText  (=self) -> str
fn nmLabelSetColor = Label.setColor (&self, c:nmColor) -> void
fn nmLabelGetColor = Label.getColor (=self) -> nmColor

# CheckBox
fn nmCheckBoxGetText     = CheckBox.getText     (=self) -> str
fn nmCheckBoxSetText     = CheckBox.setText     (&self, text:str) -> void !err
fn nmCheckBoxIsSelected  = CheckBox.isSelected  (=self) -> bool
fn nmCheckBoxSetSelected = CheckBox.setSelected (&self, v:bool) -> void
fn nmCheckBoxGetModel    = CheckBox.getModel    (=self) -> *ToggleButtonModel @borrowed

# RadioButton
fn nmRadioButtonGetText     = RadioButton.getText     (=self) -> str
fn nmRadioButtonSetText     = RadioButton.setText     (&self, text:str) -> void !err
fn nmRadioButtonIsSelected  = RadioButton.isSelected  (=self) -> bool
fn nmRadioButtonSetSelected = RadioButton.setSelected (&self, v:bool) -> void
fn nmRadioButtonGetModel    = RadioButton.getModel    (=self) -> *ToggleButtonModel @borrowed

# Slider
fn nmSliderGetOrientation = Slider.getOrientation (=self) -> nmOrientation
fn nmSliderSetOrientation = Slider.setOrientation (&self, o:nmOrientation) -> void
fn nmSliderGetModel       = Slider.getModel       (=self) -> *BoundedRangeModel @borrowed

# ScrollBar
fn nmScrollBarGetModel          = ScrollBar.getModel          (=self) -> *BoundedRangeModel @borrowed
fn nmScrollBarGetValue          = ScrollBar.getValue          (=self) -> i32
fn nmScrollBarSetValue          = ScrollBar.setValue          (&self, v:i32) -> void
fn nmScrollBarGetOrientation    = ScrollBar.getOrientation    (=self) -> nmScrollOrientation
fn nmScrollBarSetUnitIncrement  = ScrollBar.setUnitIncrement  (&self, px:i32) -> void
fn nmScrollBarSetBlockIncrement = ScrollBar.setBlockIncrement (&self, px:i32) -> void
fn nmScrollBarOnChange          = ScrollBar.addChangeListener    (&self, cb:nmChangeListener) -> void !err
fn nmScrollBarOffChange         = ScrollBar.removeChangeListener (&self, cb:nmChangeListener) -> void

# Panel (background is an optional Color; Border has a nested Color -> not yet supported)
fn nmPanelGetBackground = Panel.getBackground (=self) -> ?nmColor
fn nmPanelSetBackground = Panel.setBackground (&self, c:?nmColor) -> void

# TextField
fn nmTextFieldGetText       = TextField.getText       (=self) -> str
fn nmTextFieldSetText       = TextField.setText       (&self, text:str) -> void !err
fn nmTextFieldGetCaretColor = TextField.getCaretColor (=self) -> nmColor
fn nmTextFieldSetCaretColor = TextField.setCaretColor (&self, c:nmColor) -> void
fn nmTextFieldGetBackground = TextField.getBackground (=self) -> nmColor
fn nmTextFieldSetBackground = TextField.setBackground (&self, c:nmColor) -> void
fn nmTextFieldOnSubmit  = TextField.addSubmitListener    (&self, cb:nmChangeListener) -> void !err
fn nmTextFieldOffSubmit = TextField.removeSubmitListener (&self, cb:nmChangeListener) -> void
fn nmTextFieldOnCancel  = TextField.addCancelListener    (&self, cb:nmChangeListener) -> void !err
fn nmTextFieldOffCancel = TextField.removeCancelListener (&self, cb:nmChangeListener) -> void

# TextArea (getText takes *self here, hence &self)
fn nmTextAreaGetText       = TextArea.getText       (&self) -> str
fn nmTextAreaSetText       = TextArea.setText       (&self, text:str) -> void !err
fn nmTextAreaGetLineWrap   = TextArea.getLineWrap   (=self) -> bool
fn nmTextAreaSetLineWrap   = TextArea.setLineWrap   (&self, wrap:bool) -> void
fn nmTextAreaGetCaretColor = TextArea.getCaretColor (=self) -> nmColor
fn nmTextAreaSetCaretColor = TextArea.setCaretColor (&self, c:nmColor) -> void
fn nmTextAreaGetBackground = TextArea.getBackground (=self) -> nmColor
fn nmTextAreaSetBackground = TextArea.setBackground (&self, c:nmColor) -> void

# Window (borrowed via nmFrameAsWindow). setMenuBar / requestFocusFor take an
# optional handle (?*T): pass NULL to clear. The bar's ownership is managed by
# the Frame (Window borrows it), so no transfer here.
fn nmWindowSetTitle      = Window.setTitle      (&self, title:str) -> void !err
fn nmWindowGetTitle      = Window.getTitle      (=self) -> str
fn nmWindowAdd           = Window.add           (&self, child:*Component @transfer) -> void !err
fn nmWindowSetPos        = Window.setPos        (&self, x:i32, y:i32) -> void
fn nmWindowSetSize       = Window.setSize       (&self, width:i32, height:i32) -> void
fn nmWindowGetPos        = Window.getPos        (=self) -> nmWindowPoint
fn nmWindowGetSize       = Window.getSize       (=self) -> nmWindowSize
fn nmWindowGetBackground = Window.getBackground (=self) -> nmColor
fn nmWindowSetBackground = Window.setBackground (&self, c:nmColor) -> void
fn nmWindowRepaint       = Window.repaint       (&self) -> void
fn nmWindowRedraw        = Window.redraw        (&self) -> void
fn nmWindowDispose       = Window.dispose       (&self) -> void
fn nmWindowShouldClose   = Window.shouldClose   (=self) -> bool
fn nmWindowSetMenuBar    = Window.setMenuBar      (&self, bar:?*Component @borrowed) -> void !err
fn nmWindowRequestFocus  = Window.requestFocusFor (&self, c:?*Component @borrowed) -> void

# Frame menu bar. setMenuBar takes ownership (Frame destroys the bar on replace /
# deinit); setMenuBarBorrowed does not. Pass NULL to detach. getMenuBar borrows.
fn nmFrameSetMenuBar         = Frame.setMenuBar         (&self, bar:?*MenuBar @transfer) -> void !err
fn nmFrameSetMenuBarBorrowed = Frame.setMenuBarBorrowed (&self, bar:?*MenuBar @borrowed) -> void !err
fn nmFrameGetMenuBar         = Frame.getMenuBar         (=self) -> ?*MenuBar @borrowed

# Dialog (#3). Caller-owned: nmDialogDestroy is hand-written (deinit + free; the
# Application does not free dialogs). showModal blocks (nested UI loop) and returns
# the result; populate the dialog via nmDialogAsWindow (Window.add etc.).
fn nmAppDialog       = Application.dialog (&self, owner:*Window, title:str, w:u32, h:u32) -> *Dialog !null @owned
fn nmDialogShowModal = Dialog.showModal (&self) -> nmDialogResult
fn nmDialogShow      = Dialog.show      (&self) -> void !err
fn nmDialogClose     = Dialog.close     (&self, result:nmDialogResult) -> void
fn nmDialogGetResult = Dialog.getResult (=self) -> nmDialogResult
fn nmDialogIsModal   = Dialog.isModal   (=self) -> bool
fn nmDialogIsShown   = Dialog.isShown   (=self) -> bool

# MenuItem (icon get/set take awt.Image by value -> bespoke, like Button's)
fn nmMenuItemGetText  = MenuItem.getText  (=self) -> str
fn nmMenuItemSetText  = MenuItem.setText  (&self, text:str) -> void !err
fn nmMenuItemGetModel = MenuItem.getModel (=self) -> *ButtonModel @borrowed

# CheckBoxMenuItem
fn nmCheckBoxMenuItemGetText    = CheckBoxMenuItem.getText    (=self) -> str
fn nmCheckBoxMenuItemSetText    = CheckBoxMenuItem.setText    (&self, text:str) -> void !err
fn nmCheckBoxMenuItemIsChecked  = CheckBoxMenuItem.isChecked  (=self) -> bool
fn nmCheckBoxMenuItemSetChecked = CheckBoxMenuItem.setChecked (&self, v:bool) -> void
fn nmCheckBoxMenuItemGetModel   = CheckBoxMenuItem.getModel   (=self) -> *ToggleButtonModel @borrowed

# Menu
fn nmMenuGetText      = Menu.getText      (=self) -> str
fn nmMenuSetText      = Menu.setText      (&self, text:str) -> void !err
fn nmMenuGetModel     = Menu.getModel     (=self) -> *ButtonModel @borrowed
fn nmMenuAdd          = Menu.add          (&self, child:*Component @transfer) -> void !err
fn nmMenuAddSeparator = Menu.addSeparator (&self) -> void !err
fn nmMenuShow         = Menu.show         (&self, w:*Window, anchor:nmPoint) -> void !err
fn nmMenuHide         = Menu.hide         (&self) -> void

# MenuBar
fn nmMenuBarAdd   = MenuBar.add   (&self, menu:*Menu @transfer) -> void !err
fn nmMenuBarCount = MenuBar.count (=self) -> usize
fn nmMenuBarAt    = MenuBar.at    (=self, index:usize) -> ?*Menu @borrowed

# PopupMenu (a free overlay, not a Component: it owns its own destructor)
fn nmPopupMenuAdd          = PopupMenu.add          (&self, item:*Component @transfer) -> void !err
fn nmPopupMenuAddSeparator = PopupMenu.addSeparator (&self) -> void !err
fn nmPopupMenuShow         = PopupMenu.show         (&self, w:*Window, x:f32, y:f32) -> void !err
fn nmPopupMenuHide         = PopupMenu.hide         (&self) -> void
fn nmPopupMenuDestroy      = PopupMenu.destroy      (&self) -> void

# ButtonModel (state flags + change / action listeners)
fn nmButtonModelSetPressed  = ButtonModel.setPressed  (&self, v:bool) -> void
fn nmButtonModelIsPressed   = ButtonModel.isPressed   (&self) -> bool
fn nmButtonModelSetArmed    = ButtonModel.setArmed    (&self, v:bool) -> void
fn nmButtonModelIsArmed     = ButtonModel.isArmed     (&self) -> bool
fn nmButtonModelSetRollover = ButtonModel.setRollover (&self, v:bool) -> void
fn nmButtonModelIsRollover  = ButtonModel.isRollover  (&self) -> bool
fn nmButtonModelSetEnabled  = ButtonModel.setEnabled  (&self, v:bool) -> void
fn nmButtonModelIsEnabled   = ButtonModel.isEnabled   (&self) -> bool
fn nmButtonModelFireAction  = ButtonModel.fireAction  (&self) -> void
fn nmButtonModelOnChange    = ButtonModel.addChangeListener    (&self, cb:nmChangeListener) -> void !err
fn nmButtonModelOffChange   = ButtonModel.removeChangeListener (&self, cb:nmChangeListener) -> void
fn nmButtonModelOnAction    = ButtonModel.addActionListener    (&self, cb:nmChangeListener) -> void !err
fn nmButtonModelOffAction   = ButtonModel.removeActionListener (&self, cb:nmChangeListener) -> void

# ToggleButtonModel
fn nmToggleButtonModelIsSelected  = ToggleButtonModel.isSelected  (&self) -> bool
fn nmToggleButtonModelSetSelected = ToggleButtonModel.setSelected (&self, v:bool) -> void
fn nmToggleButtonModelFireAction  = ToggleButtonModel.fireAction  (&self) -> void
fn nmToggleButtonModelOnChange    = ToggleButtonModel.addChangeListener    (&self, cb:nmChangeListener) -> void !err
fn nmToggleButtonModelOffChange   = ToggleButtonModel.removeChangeListener (&self, cb:nmChangeListener) -> void
fn nmToggleButtonModelOnAction    = ToggleButtonModel.addActionListener    (&self, cb:nmChangeListener) -> void !err
fn nmToggleButtonModelOffAction   = ToggleButtonModel.removeActionListener (&self, cb:nmChangeListener) -> void

# BoundedRangeModel (Slider / ScrollBar value model)
fn nmBoundedRangeModelGetValue           = BoundedRangeModel.getValue           (&self) -> i32
fn nmBoundedRangeModelSetValue           = BoundedRangeModel.setValue           (&self, v:i32) -> void
fn nmBoundedRangeModelGetMin             = BoundedRangeModel.getMin             (&self) -> i32
fn nmBoundedRangeModelGetMax             = BoundedRangeModel.getMax             (&self) -> i32
fn nmBoundedRangeModelGetExtent          = BoundedRangeModel.getExtent          (&self) -> i32
fn nmBoundedRangeModelSetRange           = BoundedRangeModel.setRange           (&self, min:i32, max:i32) -> void
fn nmBoundedRangeModelSetExtent          = BoundedRangeModel.setExtent          (&self, extent:i32) -> void
fn nmBoundedRangeModelSetRangeProperties = BoundedRangeModel.setRangeProperties (&self, min:i32, value:i32, max:i32, extent:i32) -> void
fn nmBoundedRangeModelOnChange           = BoundedRangeModel.addChangeListener    (&self, cb:nmChangeListener) -> void !err
fn nmBoundedRangeModelOffChange          = BoundedRangeModel.removeChangeListener (&self, cb:nmChangeListener) -> void

# Layout managers (#13). Built-in layouts are process-wide singletons taken by
# receiver-less zero-arg factories (no allocator) — always borrowed, never freed.
# setLayout/getLayout ride on the optional handle (?*LayoutManager). BorderLayout
# places children by region via add() (wraps the raw void* hint internally).
fn nmBoxLayoutHorizontal = BoxLayout.horizontal () -> *LayoutManager @borrowed
fn nmBoxLayoutVertical   = BoxLayout.vertical   () -> *LayoutManager @borrowed
fn nmBorderLayoutGet     = BorderLayout.get     () -> *LayoutManager @borrowed
fn nmContainerSetLayout  = Container.setLayout (&self, layout:?*LayoutManager @borrowed) -> void
fn nmContainerGetLayout  = Container.getLayout (&self) -> ?*LayoutManager @borrowed
fn nmBorderLayoutAdd     = BorderLayout.add (container:*Container, region:nmBorderRegion, child:*Component @transfer) -> void !err

# Upcast to the embedded Component (one-line `return &self.<field>`). Lets a
# binding reach Container methods on any widget and feed nmComponentDestroy.
cast nmButtonAsComponent    = Button.component    -> Component
cast nmContainerAsComponent = Container.component -> Component
cast nmListAsComponent      = List.component      -> Component
cast nmLabelAsComponent            = Label.component            -> Component
cast nmCheckBoxAsComponent         = CheckBox.component         -> Component
cast nmRadioButtonAsComponent      = RadioButton.component      -> Component
cast nmSliderAsComponent           = Slider.component           -> Component
cast nmScrollBarAsComponent        = ScrollBar.component        -> Component
cast nmTextFieldAsComponent        = TextField.component        -> Component
cast nmTextAreaAsComponent         = TextArea.component         -> Component
cast nmMenuItemAsComponent         = MenuItem.component         -> Component
cast nmCheckBoxMenuItemAsComponent = CheckBoxMenuItem.component -> Component
cast nmMenuAsComponent             = Menu.component             -> Component
cast nmMenuBarAsComponent          = MenuBar.component          -> Component
cast nmMenuSeparatorAsComponent    = MenuSeparator.component    -> Component
# Panel wraps a Container (-> Component via nmContainerAsComponent).
cast nmPanelAsContainer            = Panel.container            -> Container
# Frame owns its top-level Window.
cast nmFrameAsWindow               = Frame.window               -> Window
# Dialog embeds its top-level Window (populate the dialog via Window methods).
cast nmDialogAsWindow              = Dialog.window               -> Window

# Single generic destructor: dispatches the widget's own vtable.destroy using
# the allocator stored on the Component. Free any widget via its nmComponent*.
destroy nmComponentDestroy = Component
