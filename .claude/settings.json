{
  "permissions": {
    "deny": [
      "Read(./debug.log)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",

      "Write(*.h)",
      "Edit(*.h)",
      "Write(*.c)",
      "Edit(*.c)",
      "Write(*.m)",
      "Edit(*.m)",
      "Write(*.zig)",
      "Edit(*.zig)",

      "Write(./.claude/settings.json)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.local.json)",
      "Edit(./.claude/settings.local.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git pull *)",
      "WebFetch"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log -n *)",
      "Bash(git add *)",
      "Bash(git commit *)",

      "Bash(zig build *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/unsafe-on-edit.py"]
          }
        ]
      }
    ]
  },
  "env": {
    "EDITOR": "code --wait",
    "VISUAL": "code --wait"
  }
}